{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {"name":"Python Debugger: Current File","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal"},
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "campusmart-flutter-app",
            "cwd": "campusmart-flutter-app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "campusmart-flutter-app (profile mode)",
            "cwd": "campusmart-flutter-app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "campusmart-flutter-app (release mode)",
            "cwd": "campusmart-flutter-app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}